# Linux konteynerlerine bağlanan/kopyalanan dosyalar CRLF olmamalı (Windows'ta core.autocrlf=true olsa bile)
*.sh text eol=lf
Dockerfile text eol=lf
docker/** text eol=lf
.dockerignore text eol=lf
# Üretim dağıtım dosyaları (Linux'ta çalışır/konteynere bağlanır): her zaman LF
deploy/** text eol=lf
frontend/caddy/** text eol=lf
