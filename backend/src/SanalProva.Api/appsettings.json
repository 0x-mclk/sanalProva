{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "ConnectionStrings": {
    "Main": null
  },
  "Storage": {
    "Provider": "Local",
    "LocalRoot": "../../../storage",
    "SigningKey": "",
    "CustomerImageUrlTtlSeconds": 300,
    "CatalogImageUrlTtlSeconds": 3600
  },
  "ImageWorker": {
    "BaseUrl": "http://127.0.0.1:8090",
    "InternalKey": "",
    "TimeoutSeconds": 60
  },
  "Generation": {
    "UseMockProviders": true,
    "MaxParallelJobs": 4,
    "Mock": { "DelayMs": 1500, "FailureRate": 0 },
    "Budget": {
      "AllowPaidCalls": false,
      "Enforce": true,
      "DailyLimitUsd": 10,
      "MonthlyLimitUsd": 150,
      "MaxJobCostUsd": 0.5
    },
    "Strategies": {
      "OutfitSet": { "Provider": "Fashn", "Model": "tryon-max", "Options": { "resolution": "1k", "generation_mode": "balanced", "return_base64": "true" } },
      "FreeCombination": { "Provider": "Gemini", "Model": "gemini-3-pro-image", "Options": { "image_size": "2K" } },
      "ProductSwap": { "Provider": "Gemini", "Model": "gemini-nano-banana-2.1", "Options": { "image_size": "2K" } },
      "VariantPreview": { "Provider": "Gemini", "Model": "gemini-nano-banana-2.1", "Options": { "image_size": "2K" } },
      "Recolor": { "Provider": "ImageWorker", "Model": "opencv-lab-v1", "Fallback": "ProductSwap" }
    }
  },
  "Ai": {
    "Fashn": { "BaseUrl": "https://api.fashn.ai/", "ApiKey": "", "RequestTimeoutSeconds": 30, "MaxWaitSeconds": 150, "PollIntervalMs": 2000 },
    "Gemini": { "BaseUrl": "https://generativelanguage.googleapis.com/", "ApiKey": "", "ApiRevision": "2026-05-20", "RequestTimeoutSeconds": 150 }
  },
  "Seed": {
    "Enabled": false
  }
}
