# Docker Compose ortam şablonu. GERÇEK değer yazmayın: ./scripts/compose-env.ps1 (Windows) veya scripts/compose-env.sh (CI/Linux) rastgele değerlerle .env üretir.
# .env git'e girmez (.gitignore). Parolalar yalnızca harf+rakam olmalı (sqlcmd -v ve bağlantı dizesi kaçış sorunlarını önler).
MSSQL_SA_PASSWORD=CHANGE_ME
SP_MIGRATOR_PW=CHANGE_ME
SP_APP_PW=CHANGE_ME
STORAGE_SIGNING_KEY=CHANGE_ME_AT_LEAST_32_CHARS
IMAGE_WORKER_KEY=CHANGE_ME

# İsteğe bağlı
# API_ENVIRONMENT=Development
# API_HOST_PORT=8080
# MSSQL_HOST_PORT=14331
# Demo tohumu (yalnızca Development): SEED_ENABLED=true ve SEED_DEV_PASSWORD gerekir; varsayılan KAPALI
# SEED_ENABLED=false
# SEED_DEV_PASSWORD=
